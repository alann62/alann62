# Copia este archivo como ".env" y completa los datos reales.
# NUNCA subas el archivo ".env" real a git (ya está en .gitignore).

SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USER=comercial@fynova.com.ar
SMTP_PASSWORD=coloca_aqui_la_contrasena_o_app_password

# Nombre que se muestra como remitente
REMITENTE_NOMBRE=Fynova - Ingenieria y Redes contra Incendio

# Límite de correos por minuto (para no saturar el servidor SMTP)
CORREOS_POR_MINUTO=20
